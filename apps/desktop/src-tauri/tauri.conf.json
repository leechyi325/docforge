{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocForge",
  "version": "0.1.0",
  "identifier": "com.docforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocForge",
        "width": 1200,
        "height": 760
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/docforge-engine",
      "binaries/pandoc"
    ]
  }
}
